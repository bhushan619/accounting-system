PORT=4005
MONGODB_URI=mongodb://mongo:27005/velosync
# IMPORTANT: JWT_SECRET must be at least 32 characters - generate with: openssl rand -base64 64
JWT_SECRET=your-secure-secret-here-at-least-32-characters
JWT_EXP=15m
REFRESH_EXP=7d
UPLOADS_DIR=./uploads
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Frontend URL for password reset emails
FRONTEND_URL=http://localhost:5173
